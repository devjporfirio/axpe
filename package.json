{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^10.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next build && NODE_ENV=production node server.js",
    "api": "node api/index.js",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint",
      "git add"
    ],
    "src/**/*.jsx": [
      "eslint",
      "git add"
    ],
    "pages/**/*.js": [
      "eslint",
      "git add"
    ],
    "pages/**/*.jsx": [
      "eslint",
      "git add"
    ]
  },
  "pre-commit": "lint-staged",
  "browserslist": [
    "last 2 versions",
    ">1%"
  ],
  "dependencies": {
    "@zeit/next-css": "^1.0.1",
    "@zeit/next-sass": "^1.0.1",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "file-loader": "^4.2.0",
    "google-map-react": "^1.1.5",
    "isomorphic-unfetch": "^3.0.0",
    "js-cookie": "^2.2.1",
    "next": "9.1.1",
    "next-fonts": "^0.19.0",
    "next-redux-wrapper": "^4.0.1",
    "node-sass": "^4.13.0",
    "react": "16.11.0",
    "react-dom": "16.11.0",
    "react-inlinesvg": "^1.1.7",
    "react-redux": "^7.1.1",
    "react-slick": "^0.25.2",
    "redux": "^4.0.4",
    "redux-devtools-extension": "^2.13.8",
    "redux-thunk": "^2.3.0",
    "slick-carousel": "^1.8.1",
    "styled-components": "^4.4.0",
    "styled-media-query": "^2.1.2",
    "webpack": "^4.41.2"
  },
  "devDependencies": {
    "babel-eslint": "^10.0.3",
    "babel-plugin-styled-components": "^1.10.6",
    "eslint": "^6.6.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^6.5.0",
    "eslint-plugin-compat": "^3.3.0",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-react": "^7.16.0",
    "eslint-plugin-react-hooks": "^2.2.0",
    "lint-staged": "^9.4.2",
    "pre-commit": "^1.2.2",
    "prettier": "^1.18.2",
    "redux-logger": "^3.0.6",
    "url-loader": "^2.2.0"
  }
}
